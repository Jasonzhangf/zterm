{
  "name": "zterm",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "verify:local": "pnpm run test:repo-layout && pnpm run test:repo-layout-protocol && pnpm run test:gate-protocol",
    "verify:ci": "pnpm run verify:local && pnpm run test:active-governance-gates && pnpm --dir android run test:feature-registry",
    "test:repo-layout": "node ./scripts/check-repo-layout.mjs",
    "test:repo-layout-protocol": "node --test ./scripts/check-repo-layout.test.mjs",
    "test:gate-protocol": "node --test ./scripts/run-gate.test.mjs",
    "test:active-governance-gates": "node --test ./scripts/verify-active-governance-gates.test.mjs",
    "archive:test:cordis-v2-governance": "node ./scripts/verify-cordis-v2-governance.mjs",
    "archive:test:cordis-v2-governance:negative": "node --test ./scripts/verify-cordis-v2-governance.test.mjs",
    "archive:test:v2:map-registries": "node ./scripts/check-zterm-v2-map-registries.mjs",
    "dev": "pnpm --filter @zterm/android dev",
    "build": "pnpm --filter @zterm/android build",
    "type-check": "pnpm --filter @zterm/android type-check",
    "dev:mac": "pnpm --filter @zterm/mac dev",
    "build:mac": "pnpm --filter @zterm/mac build",
    "package:mac": "pnpm --filter @zterm/mac package",
    "build:android": "pnpm --filter @zterm/android build:android",
    "sync:android": "pnpm --filter @zterm/android sync:android",
    "daemon": "pnpm --filter @zterm/android daemon",
    "daemon:start": "pnpm --filter @zterm/android daemon:start",
    "daemon:status": "pnpm --filter @zterm/android daemon:status",
    "daemon:stop": "pnpm --filter @zterm/android daemon:stop",
    "archive:test:v2-parity-catalog": "node ./scripts/validate-zterm-v2-parity-catalog.mjs",
    "archive:test:v2-parity-catalog:negative": "node --test ./scripts/validate-zterm-v2-parity-catalog.test.mjs",
    "test:kernel-lifecycle": "pnpm --dir packages/kernel test",
    "test:stream-boundary": "pnpm --dir packages/stream-boundary run type-check && pnpm --dir packages/stream-boundary run test",
    "test:phase7-four-platform-parity": "node ./scripts/check-phase7-four-platform-parity.mjs",
    "test:phase7-four-platform-parity:negative": "node ./scripts/check-phase7-four-platform-parity.test.mjs"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "jsdom": "29.0.2",
    "vitest": "1.6.0"
  }
}
