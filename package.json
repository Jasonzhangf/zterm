{
  "name": "zterm",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "test:repo-layout": "node ./scripts/check-repo-layout.mjs",
    "test:cordis-v2-governance": "node ./scripts/verify-cordis-v2-governance.mjs",
    "test:cordis-v2-governance:negative": "node --test ./scripts/verify-cordis-v2-governance.test.mjs",
    "test:v2:map-registries": "node ./scripts/check-zterm-v2-map-registries.mjs",
    "dev": "pnpm --filter @zterm/android dev",
    "build": "pnpm --filter @zterm/android build",
    "type-check": "pnpm --filter @zterm/android type-check",
    "dev:mac": "pnpm --filter @zterm/mac dev",
    "build:mac": "pnpm --filter @zterm/mac build",
    "package:mac": "pnpm --filter @zterm/mac package",
    "build:android": "pnpm --filter @zterm/android build:android",
    "sync:android": "pnpm --filter @zterm/android sync:android",
    "daemon": "pnpm --filter @zterm/android daemon",
    "daemon:start": "pnpm --filter @zterm/android daemon:start",
    "daemon:status": "pnpm --filter @zterm/android daemon:status",
    "daemon:stop": "pnpm --filter @zterm/android daemon:stop",
    "test:v2-parity-catalog": "node ./scripts/validate-zterm-v2-parity-catalog.mjs",
    "test:v2-parity-catalog:negative": "node --test ./scripts/validate-zterm-v2-parity-catalog.test.mjs"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "jsdom": "29.0.2",
    "vitest": "1.6.0"
  }
}
