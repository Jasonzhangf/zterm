    { "from": "解析有效且作用域匹配的工作引用", "to": "解析目标成员及匹配职责", "arc_id": "arc.work_reference_result" },
    { "from": "解析目标成员及匹配职责", "to": "判断授权工作引用成员与职责是否全部有效", "arc_id": "arc.target_membership_duty_result" },
    { "from": "判断授权工作引用成员与职责是否全部有效", "to": "仅授权工作引用成员职责全部成立时创建队列项并保持工作owner不变", "arc_id": "arc.enqueue_eligibility" },
    { "from": "判断授权工作引用成员与职责是否全部有效", "to": "对未准入请求返回无队列副作用的拒绝结果", "arc_id": "arc.enqueue_eligibility" },
    { "from": "仅授权工作引用成员职责全部成立时创建队列项并保持工作owner不变", "to": "合并入队与拒绝结果为单一操作结果", "arc_id": "arc.queue_create_result" },
    { "from": "对未准入请求返回无队列副作用的拒绝结果", "to": "合并入队与拒绝结果为单一操作结果", "arc_id": "arc.queue_rejection_result" },
    { "from": "合并入队与拒绝结果为单一操作结果", "to": "发布唯一入队结果", "arc_id": "arc.enqueue_outcome" }
  ],
  "outputs": ["arc.enqueue_response"]
