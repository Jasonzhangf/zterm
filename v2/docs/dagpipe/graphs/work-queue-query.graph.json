    { "from": "按稳定成员身份与精确work reference只读匹配队列项", "to": "返回类型化队列项未找到结果", "arc_id": "arc.queue_query_match" },
    { "from": "按稳定成员身份与精确work reference只读匹配队列项", "to": "投影持久队列项字段并排除连接与绑定字段", "arc_id": "arc.queue_query_match" },
    { "from": "拒绝未授权读取且不访问组织身份或队列状态", "to": "合并所有只读查询结果为唯一响应", "arc_id": "arc.queue_query_rejection" },
    { "from": "返回稳定身份未解析或不存在的类型化结果", "to": "合并所有只读查询结果为唯一响应", "arc_id": "arc.queue_query_identity_not_found" },
    { "from": "返回类型化队列项未找到结果", "to": "合并所有只读查询结果为唯一响应", "arc_id": "arc.queue_query_item_not_found" },
    { "from": "投影持久队列项字段并排除连接与绑定字段", "to": "合并所有只读查询结果为唯一响应", "arc_id": "arc.queue_query_item_projection" },
    { "from": "合并所有只读查询结果为唯一响应", "to": "发布唯一队列查询响应且不产生队列工作分配或终态副作用", "arc_id": "arc.queue_query_outcome" }
  ],
  "outputs": ["arc.queue_query_response"]
