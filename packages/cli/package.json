{
  "name": "@jsonstudio/zterm-cli",
  "version": "0.1.0",
  "description": "ZTerm remote daemon terminal CLI.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "zterm": "./bin/zterm.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:fixture": "node ./scripts/build.mjs --fixture",
    "pack:release": "node ./scripts/pack.mjs",
    "test": "vitest run && tsx --test src/account-state.test.ts src/slot-store.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@roamhq/wrtc": "^0.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "zterm",
    "terminal",
    "daemon",
    "cli"
  ]
}
