{
  "access": {
    "protected_paths": [
      ".appsdk/**",
      "active/lib/**",
      "generated/**",
      "protected/source/**",
      "protected/history/**"
    ]
  },
  "governance": {
    "active_kind": "immutable_consumable_library",
    "active_root": "active/lib/**",
    "debug_merge_comment_required": true,
    "freeze_requirements": [
      "git_clean",
      "source_commit_or_tag",
      "library_hash",
      "public_api_hash",
      "review_pass",
      "previous_active_immutable"
    ],
    "generated_kinds": [
      "compiler_output",
      "indexes"
    ],
    "generated_root": "generated/**",
    "playground_retention": "archive_then_remove",
    "playground_root": "playground/experiments/**",
    "promotion_requires": [
      "experiment_evidence",
      "architecture_review_pass",
      "unique_owner",
      "required_gates"
    ],
    "protected_kinds": [
      "source",
      "contracts",
      "history"
    ],
    "protected_root": "protected/**",
    "record_contracts": [
      "contracts/records/worktree-record.schema.json",
      "contracts/records/reproduction-record.schema.json",
      "contracts/records/evidence-record.schema.json",
      "contracts/records/fix-candidate-record.schema.json",
      "contracts/records/goal-clarification-record.schema.json",
      "contracts/records/review-record.schema.json",
      "contracts/records/effectiveness-record.schema.json",
      "contracts/records/merge-record.schema.json",
      "contracts/records/promotion-record.schema.json",
      "contracts/records/regression-report.schema.json",
      "contracts/records/freeze-record.schema.json",
      "contracts/records/record-graph.contract.json"
    ],
    "runtime_forbidden_roots": [
      "playground/**",
      "generated/**",
      "protected/source/**"
    ],
    "zone_transition_contract": "contracts/transitions/zone-transition-manifest.json"
  },
  "lifecycle": {
    "stage": "controlled_verified"
  },
  "lifecycles": {
    "artifact": "generated",
    "issue": "open",
    "library": "draft",
    "source_snapshot": "mutable"
  },
  "modules": [
    {
      "active_artifact": "active/lib/zterm-runtime-v2/**",
      "artifact_paths": [
        "zterm-runtime-v2.web.tgz"
      ],
      "build": {
        "args": [
          "-lc",
          "pnpm run build && rm -f generated/modules/zterm-runtime-v2/lib/zterm-runtime-v2.web.tgz && mkdir -p generated/modules/zterm-runtime-v2/lib && tar -czf generated/modules/zterm-runtime-v2/lib/zterm-runtime-v2.web.tgz -C dist ."
        ],
        "program": "bash",
        "working_directory": "."
      },
      "contract_paths": [
        "contracts/records/**",
        "contracts/transitions/**",
        "docs/design/2026-08-14-zterm-runtime-architecture-v2.md",
        "docs/goals/zterm-runtime-architecture-v2-plan.md"
      ],
      "dependency_modules": [],
      "generated_outputs": [
        "generated/modules/zterm-runtime-v2/**"
      ],
      "module_id": "zterm-runtime-v2",
      "owned_paths": [
        "playground/experiments/zterm-runtime-architecture-v2/**",
        "src/**",
        "native/android/app/src/main/**",
        "docs/**",
        "scripts/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "index.html"
      ],
      "regression": {
        "allow_skipped": false,
        "command": {
          "args": [
            "exec",
            "vitest",
            "run",
            "src/server/terminal-message-runtime.test.ts",
            "src/server/terminal-mirror-runtime.test.ts",
            "src/server/daemon-buffer-publisher-runtime.test.ts",
            "src/lib/runtime-architecture-v2.test.ts",
            "src/lib/plugin-host/plugin-host-runtime.test.ts",
            "src/pages/TerminalPage.render-isolation.test.tsx",
            "src/App.dynamic-refresh.test.tsx",
            "src/contexts/SessionContext.ws-refresh.test.tsx",
            "--reporter=dot"
          ],
          "program": "pnpm",
          "working_directory": "."
        },
        "input_paths": [
          "playground/experiments/zterm-runtime-architecture-v2/**",
          "src/**"
        ],
        "minimum_test_count": 1,
        "ordinary_mode_after_freeze": "disabled",
        "reenable_on": [
          "source_change",
          "contract_change",
          "public_api_change",
          "artifact_change",
          "dependency_change"
        ],
        "required_before_freeze": true,
        "suite_id": "zterm-runtime-v2-regression"
      },
      "source_owner": "zterm-runtime-v2",
      "stage": "source_implemented",
      "version_base": {
        "base_artifact_hash": "sha256:ab527a800da96f8f1bb3b038649c5882f3e016dd0eef0749e32bb9a50ae152e8",
        "base_source_commit": "77bbf60375d5a4d111c4bf5f5080e31e5ac70561",
        "new_active_version": "active-v3",
        "previous_active_version": "active-v2"
      }
    }
  ],
  "project_id": "zterm-runtime-architecture-v2",
  "schema_version": 1,
  "sdk": {
    "bundle_manifest": ".appsdk/contracts/sdk-bundle.manifest.json",
    "name": "appsdk",
    "resource_record": ".appsdk/sdk-resources.json",
    "version": "0.1.3"
  }
}
