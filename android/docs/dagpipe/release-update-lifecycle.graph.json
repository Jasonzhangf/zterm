      "inputs": ["arc.verified_download"],
      "output": { "id": "arc.client_update_installed", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    }
  ],
  "edges": [
    { "from": "check_update", "to": "download_update", "arc_id": "arc.update_available" },
    { "from": "download_update", "to": "verify_update", "arc_id": "arc.downloaded_update" },
    { "from": "verify_update", "to": "install_client_update", "arc_id": "arc.verified_download" }
  ],
  "outputs": ["arc.client_update_installed"]
