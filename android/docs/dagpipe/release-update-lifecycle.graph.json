      "operator_version": "0.1",
      "inputs": ["arc.update_check", "arc.update_policy"],
      "output": { "id": "arc.update_available", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    },
    {
      "id": "download_update",
      "operator": "release.update_artifact.download",
      "operator_version": "0.1",
      "inputs": ["arc.update_available"],
      "output": { "id": "arc.downloaded_update", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    },
    {
      "id": "verify_update",
      "operator": "release.update_artifact.verify_download",
      "operator_version": "0.1",
      "inputs": ["arc.downloaded_update"],
      "output": { "id": "arc.verified_download", "schema": "Object" },
      "input_selector": { "include": [], "exclude": [], "predicate": null },
      "output_selector": { "include": [], "exclude": [], "predicate": null },
      "iterator": "Whole"
    },
    {
      "id": "install_client_update",
